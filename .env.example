# Copy to .env for local development. These are intentionally non-production values.
CYBER_ADMIN_TOKEN=local-admin-change-me-please
ENFORCEMENT_MODE=detection
MODSEC_RULE_ENGINE=DetectionOnly
DEFAULT_REQUEST_LIMIT=10
PORT_SCAN_UNIQUE_PORTS=10
PORT_SCAN_WINDOW_SECONDS=60
PORT_SCAN_COOLDOWN_SECONDS=60
BACKEND=http://express-demo:8081
SECURITY_API_URL=http://api:8000
ALLOW_TEST_CLIENT_IP=0
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# Enable these two settings when you want detected attacks blocked.
# ENFORCEMENT_MODE=enforcement
# MODSEC_RULE_ENGINE=On
# SENSOR_INTERFACE=eth0
